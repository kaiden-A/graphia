# ---------------------------------------------------------------------------
# Graphia server settings
# Copy this file to server/.env and fill in real values.
# Never commit server/.env.
# ---------------------------------------------------------------------------

APP_NAME=Graphia
APP_ENV=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-long-random-secret

# Neon PostgreSQL. The app normalizes postgres:// to postgresql+pg8000:// and
# strips libpq-only query parameters such as sslmode.
DATABASE_URL=postgresql+pg8000://user:password@ep-example.ap-southeast-1.aws.neon.tech/graphia?sslmode=require
DB_SCHEMA=public

# Session cookie. On Firebase Hosting rewrites, use __session instead.
SESSION_COOKIE_NAME=graphia_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Signup gate. Set SIGNUP_ENABLED=false to close registration.
SIGNUP_ENABLED=true
SIGNUP_INVITE_CODE=replace-with-an-invite-code

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# Optional. Leave empty to build the endpoint from R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET=graphia
R2_REGION=auto

# Service B (internal processor)
PROCESSOR_URL=http://localhost:8001
INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# Limits
MAX_UPLOAD_MB=25
MAX_ACTIVE_JOBS_PER_USER=3
UPLOADS_PER_HOUR_PER_IP=20
DAILY_JOB_LIMIT=200
JOB_EXPIRY_HOURS=24
UPLOAD_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300

# Processor
PROCESSOR_MAX_WORKERS=1
CONVERSION_TIMEOUT_SECONDS=300
SOFFICE_BIN=soffice
