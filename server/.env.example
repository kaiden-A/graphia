# ---------------------------------------------------------------------------
# Graphia server environment
# Copy this file to server/.env and fill in real values.
# Never commit server/.env.
#
# Scope labels: [shared] [api] [processor]
# Full reference: docs/environment.md and docs/auth.md
# ---------------------------------------------------------------------------

# ===========================================================================
# [shared] Both Service A (API) and Service B (processor)
# ===========================================================================
APP_NAME=Graphia
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Neon PostgreSQL. The app normalizes postgres:// to postgresql+pg8000:// and
# strips libpq-only query parameters such as sslmode.
DATABASE_URL=postgresql+pg8000://user:password@ep-example.ap-southeast-1.aws.neon.tech/graphia?sslmode=require
DB_SCHEMA=public

# Cloudflare R2 (S3-compatible). Set R2_ACCOUNT_ID or R2_ENDPOINT.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# Optional. Leave empty to build the endpoint from R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET=graphia
R2_REGION=auto

# Service A sends this token; Service B verifies it.
INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# ===========================================================================
# [api] Service A only
# ===========================================================================
# HMAC key for the short-lived Zitadel login-handshake cookie.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-long-random-secret

# Zitadel OIDC. Web application with Authorization Code + PKCE, no client secret.
ZITADEL_ISSUER=https://<instance>.zitadel.cloud
ZITADEL_CLIENT_ID=
# Both must be registered exactly in the Zitadel application.
# These point at the *client* origin, not the API origin, because Next rewrites
# /api/* to FastAPI.
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback
ZITADEL_POST_LOGOUT_URI=http://localhost:3000/login
PUBLIC_BASE_URL=http://localhost:3000

# Session cookie. On Firebase Hosting rewrites, use __session instead.
SESSION_COOKIE_NAME=graphia_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Service B base URL. Compose uses http://processor:8080; Cloud Run uses the
# processor service URL.
PROCESSOR_URL=http://localhost:8001

# API limits
MAX_UPLOAD_MB=25
MAX_ACTIVE_JOBS_PER_USER=3
UPLOADS_PER_HOUR_PER_IP=20
UPLOADS_PER_HOUR_PER_MEMBER=120
GUEST_SESSIONS_PER_HOUR_PER_IP=10
GUEST_SESSION_TTL_HOURS=24
DAILY_JOB_LIMIT=200
JOB_EXPIRY_HOURS=24
UPLOAD_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300
CLI_AUTH_REQUEST_TTL_MINUTES=10

# ===========================================================================
# [processor] Service B only
# ===========================================================================
PROCESSOR_MAX_WORKERS=1
CONVERSION_TIMEOUT_SECONDS=300
# Absolute path on Windows: C:/Program Files/LibreOffice/program/soffice.exe
SOFFICE_BIN=soffice
# Absolute path on Windows: C:/Program Files/gs/gs10.05.1/bin/gswin64c.exe
GHOSTSCRIPT_BIN=gs

# ===========================================================================
# [test] Not read by the running services
# ===========================================================================
# Set to 1 to run pytest integration tests against Neon + R2.
# RUN_INTEGRATION=1
