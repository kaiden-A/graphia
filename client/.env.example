# ---------------------------------------------------------------------------
# Graphia client environment
# Copy to client/.env.local for local development.
# Full reference: docs/environment.md
# ---------------------------------------------------------------------------

# [client] Origin of Service A used by the server-side /api/:path* rewrite.
# Do not append /api.
API_ORIGIN=http://localhost:8000

# [client] Must match SESSION_COOKIE_NAME in server/.env.
# Use __session when the client is on Firebase Hosting.
SESSION_COOKIE_NAME=graphia_session
